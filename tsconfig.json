{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/test-render", "apps/*/src", "apps/*/test", "apps/*/test-render", "tests/smoke", "bin/*.ts", "vitest.render.config.ts"]
}
